+        //pc_pal2[i] = convert_pal(READ_WORD_ROM(&memory.pal2[i<<1]));
+        pc_pal1[i] = convert_pal(READ_WORD(&memory.vid.pal_neo[0][i<<1]));
+        pc_pal2[i] = convert_pal(READ_WORD(&memory.vid.pal_neo[1][i<<1]));
+    }
+}
