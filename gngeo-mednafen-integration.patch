+    } else
+      *p++ = '.';
+  }
+  *p = '\0';
+  for (i = 39 - strlen(dumpline); i > 0; i--) {
+    *p++ = ' ';
+  }
+  if (iibp) {
+    sprintf(p, " : %4d : %s\n", iibp->funcnum, dissline);
+  } else {
+    sprintf(p, " :      : %s\n", dissline);
+  }
+
+  return words;
+}
