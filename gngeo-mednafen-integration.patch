+static Uint8 *z80map1, *z80map2, *z80map3, *z80map4;
+
+Uint8 mame_z80mem[0x10000];
+//typedef struct Z80_STATE {
+//    Uint16 PC,SP,AF,BC,DE,HL,IX,IY;
+//    Uint16 AF2,BC2,DE2,HL2;
+//    Uint8  R,R2,IFF1,IFF2,IM,I;
