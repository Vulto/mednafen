+static void fix_value_init(void) {
+	int x, y;
+	for (x = 0; x < 40; x++) {
+		for (y = 0; y < 32; y++) {
+			fix_addr[x][y] = 0xea00 + (y << 1) + 64 * (x / 6);
+		}
+		fix_shift[x] = (5 - (x % 6));
+	}
+}
+
+#define fix_add(x, y) ((((READ_WORD(memory.vid.ram + 0xEA00 + (((y-1)&31)*2 + 64 * (x/6))) >> (5-(x%6))*2) & 3) ^ 3))
+
