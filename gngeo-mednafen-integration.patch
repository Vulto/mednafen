+							tileatr & 0x01, (unsigned char*) buffer->pixels);
+					break;
+#endif
+			}
+
+
+		}
+	} /* for count */
+
+	if (refresh) {
+		draw_fix_char(buffer->pixels, 0, 0);
+	}
+}
+
+void init_video(void) {
+#ifdef PROCESSOR_ARM
+	if (!mem_gfx) {
+		mem_gfx = memory.rom.tiles.p;
+	}
+	if (!mem_video) {
+		mem_video = memory.vid.ram;
+	}
+#elif I386_ASM
+	mem_gfx = &memory.rom.tiles.p;
+	mem_video = memory.vid.ram;
+#endif
+	fix_value_init();
+	memory.vid.modulo = 1;
