+int clocks_6or8(t_datatype type)
+{
+  int type_imm = (type == dt_ImmB) || (type == dt_ImmW) ||
+    (type == dt_ImmL) || (type == dt_Imm3) || (type == dt_Imm4) ||
+    (type == dt_Imm8) || (type == dt_Imm8s) || (type == dt_ImmS);
+
