+static __inline__ Uint16 alpha_blend(Uint16 dest, Uint16 src, Uint8 a) {
+	static Uint8 dr, dg, db, sr, sg, sb;
+
+	dr = ((dest & 0xF800) >> 11) << 3;
+	dg = ((dest & 0x7E0) >> 5) << 2;
+	db = ((dest & 0x1F)) << 3;
+
+	sr = ((src & 0xF800) >> 11) << 3;
+	sg = ((src & 0x7E0) >> 5) << 2;
+	sb = ((src & 0x1F)) << 3;
+
+	dr = (((sr - dr)*(a)) >> 8) + dr;
+	dg = (((sg - dg)*(a)) >> 8) + dg;
+	db = (((sb - db)*(a)) >> 8) + db;
+
+	return ((dr >> 3) << 11) | ((dg >> 2) << 5) | (db >> 3);
+}
+#define BLEND16_50(a,b) ((((a)&0xf7de)>>1)+(((b)&0xf7de)>>1))
