+		if ( i&0x10000 )
+		{
+			if ( i&0x800 )
+			{
+				j=MATRIMBLZ80( i );
+				j=j^0x10000;
+			}
+			else
+			{
+				j=MATRIMBLZ80(( i^0x01 ));
+			}
+		}
+		else
+		{
+			if ( i&0x800 )
+			{
+				j=MATRIMBLZ80(( i^0x01 ));
+				j=j^0x10000;
+			}
+			else
+			{
+				j=MATRIMBLZ80( i );
+			}
+		}
+		rom[ j ]=buf[ i ];
+	}
+	free( buf );
+	memcpy( rom-0x10000, rom, 0x10000 );
+
+	/* decrypt gfx */
+	cthd2003_c( machine, 0 );
+}
