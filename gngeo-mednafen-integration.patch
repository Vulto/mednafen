+    case 'z': bit = bitz; break;
+    case 'e': bit = bite; break;
+    case 'E': bit = bitE; break;
+    case 'f': bit = bitf; break;
+    case 'F': bit = bitF; break;
+    case 'n': bit = bitn; break;
