+#include "gngeo_compat.h"
+static UINT16 DAATable[0x800] = {
+  (0x00<<8)   +ZF         +VF      ,
+  (0x01<<8)                        ,
+  (0x02<<8)                        ,
+  (0x03<<8)               +VF      ,
+  (0x04<<8)                        ,
+  (0x05<<8)               +VF      ,
+  (0x06<<8)               +VF      ,
+  (0x07<<8)                        ,
+  (0x08<<8)            +XF         ,
+  (0x09<<8)            +XF+VF      ,
+  (0x10<<8)         +HF            ,
+  (0x11<<8)         +HF   +VF      ,
+  (0x12<<8)         +HF   +VF      ,
+  (0x13<<8)         +HF            ,
+  (0x14<<8)         +HF   +VF      ,
+  (0x15<<8)         +HF            ,
+  (0x10<<8)                        ,
+  (0x11<<8)               +VF      ,
+  (0x12<<8)               +VF      ,
+  (0x13<<8)                        ,
+  (0x14<<8)               +VF      ,
+  (0x15<<8)                        ,
+  (0x16<<8)                        ,
+  (0x17<<8)               +VF      ,
+  (0x18<<8)            +XF+VF      ,
+  (0x19<<8)            +XF         ,
+  (0x20<<8)      +YF+HF            ,
+  (0x21<<8)      +YF+HF   +VF      ,
