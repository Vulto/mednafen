+/**** PALETTE ****/
+/*static __inline__ */Uint16 convert_pal(Uint16 npal) {
+    int r = 0, g = 0, b = 0;
+    r = ((npal >> 7) & 0x1e) | ((npal >> 14) & 0x01);
+    g = ((npal >> 3) & 0x1e) | ((npal >> 13) & 0x01);
+    b = ((npal << 1) & 0x1e) | ((npal >> 12) & 0x01);
+
+    return (r << 11) + (g << 6) + b;
+}
