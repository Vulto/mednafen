+    */
+    if (addr == 0x00 || addr == 0x02 || addr == 0x0a)
+        return memory.vid.rbuf;//READ_WORD(&memory.vid.ram[memory.vid.vptr << 1]);
+    if (addr == 0x04)
+        return memory.vid.modulo;
+    if (addr == 0x06)
+        return read_neo_control();
+    return 0;
+}
