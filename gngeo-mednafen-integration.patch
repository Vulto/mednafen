+/***************************************************************
+ * CPD
+ ***************************************************************/
+#if Z80_EXACT
+#define CPD {													\
+	UINT8 val = RM(_HL);										\
+	UINT8 res = _A - val;										\
+	_HL--; _BC--;												\
+	_F = (_F & CF) | (SZ[res] & ~(YF|XF)) | ((_A ^ val ^ res) & HF) | NF;  \
+	if( _F & HF ) res -= 1; 									\
+	if( res & 0x02 ) _F |= YF; /* bit 1 -> flag 5 */			\
+	if( res & 0x08 ) _F |= XF; /* bit 3 -> flag 3 */			\
+	if( _BC ) _F |= VF; 										\
+}
+#else
+#define CPD {													\
+	UINT8 val = RM(_HL);										\
+	UINT8 res = _A - val;										\
+	_HL--; _BC--;												\
+	_F = (_F & CF) | SZ[res] | ((_A ^ val ^ res) & HF) | NF;	\
