+{
+    ts->del_it = 1;
+}
+
+static double inc;
+//static Uint32 inc;
+
+void my_timer(void)
+{
+    static int init = 1;
+    int i;
+
+    if (init) {
+	//timer_init_save_state();
+	init = 0;
+
+	if (conf.pal) {
+		inc = ((double) (0.02) / nb_interlace);/* *(1<<TIMER_SH);*/
+			  //(conf.sound ? (double) nb_interlace : 1.0);
+	} else {
+		inc = ((double) (0.01666) / nb_interlace); /* *(1<<TIMER_SH); */
+		//(conf.sound ? (double) nb_interlace : 1.0);
+	}
+	for (i = 0; i < MAX_TIMER; i++)
+	    timers[i].del_it = 1;
+    }
+
+    timer_count += inc;		/* 16ms par frame */
+
+    for (i = 0; i < MAX_TIMER; i++) {
+	if (timer_count >= timers[i].time && timers[i].del_it == 0) {
+	    //printf("Timer_expire %d duration=%f param=%d\n",i,timers[i].time,timers[i].param);
+	    if (timers[i].func) timers[i].func(timers[i].param);
+	    timers[i].del_it = 1;
+	}
+    }
+}
+void timer_callback_2610(int);
+size_t GnGeoTimerStateSize(void) { return sizeof(timer_count)+MAX_TIMER*(sizeof(timers[0].time)+sizeof(timers[0].param)+sizeof(timers[0].del_it)); }
+void GnGeoTimerStateSaveLoad(void *p, int load) {
+ unsigned char *q=(unsigned char*)p;
+ if(load) memcpy(&timer_count,q,sizeof(timer_count)); else memcpy(q,&timer_count,sizeof(timer_count)); q+=sizeof(timer_count);
+ for(int i=0;i<MAX_TIMER;i++){
+  if(load){memcpy(&timers[i].time,q,sizeof(timers[i].time));q+=sizeof(timers[i].time);memcpy(&timers[i].param,q,sizeof(timers[i].param));q+=sizeof(timers[i].param);memcpy(&timers[i].del_it,q,sizeof(timers[i].del_it));q+=sizeof(timers[i].del_it);timers[i].func=timer_callback_2610;}
+  else {memcpy(q,&timers[i].time,sizeof(timers[i].time));q+=sizeof(timers[i].time);memcpy(q,&timers[i].param,sizeof(timers[i].param));q+=sizeof(timers[i].param);memcpy(q,&timers[i].del_it,sizeof(timers[i].del_it));q+=sizeof(timers[i].del_it);}
+ }
+}
