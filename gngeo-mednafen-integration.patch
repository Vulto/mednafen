+/***************************************************************
+ * LDIR
+ ***************************************************************/
+#define LDIR													\
+	LDI;														\
+	if( _BC )													\
+	{															\
+		_PC -= 2;												\
+		CC(ex,0xb0);											\
+	}
+
+/***************************************************************
+ * CPIR
+ ***************************************************************/
+#define CPIR													\
+	CPI;														\
+	if( _BC && !(_F & ZF) ) 									\
+	{															\
+		_PC -= 2;												\
+		CC(ex,0xb1);											\
+	}
+
+/***************************************************************
+ * INIR
+ ***************************************************************/
+#define INIR													\
+	INI;														\
+	if( _B )													\
