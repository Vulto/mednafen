-static int zip_seek_current_file(ZFILE *gz, Uint32 offset) {
-	Uint8 *buf;
-	Uint32 s = 4096, c;
-	buf = malloc(s);
-	if (!buf)
-		return -1;
-	while (offset) {
-		c = offset;
-		if (c > s)
-			c = s;
-
-		c = gn_unzip_fread(gz, buf, c);
-		if (c == 0) {
-			break;
-		}
-		offset -= c;
-	}
-	free(buf);
-	return 0;
-
-}
