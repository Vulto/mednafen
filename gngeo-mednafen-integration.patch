+/***************************************************************
+ * IND
+ ***************************************************************/
+#if Z80_EXACT
+#define IND {													\
+	UINT8 io = IN(_BC); 										\
+	_B--;														\
+	WM( _HL, io );												\
+	_HL--;														\
+	_F = SZ[_B];												\
+	if( io & SF ) _F |= NF; 									\
+	if( ( ( (_C - 1) & 0xff) + io) & 0x100 ) _F |= HF | CF; 	\
+	if( (drep_tmp1[_C & 3][io & 3] ^							\
+		 breg_tmp2[_B] ^										\
+		 (_C >> 2) ^											\
+		 (io >> 2)) & 1 )										\
+		_F |= PF;												\
