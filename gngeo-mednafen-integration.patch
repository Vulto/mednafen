+	s32 *connect1; /* SLOT1 output pointer */
+	s32 *connect3; /* SLOT3 output pointer */
+	s32 *connect2; /* SLOT2 output pointer */
+	s32 *connect4; /* SLOT4 output pointer */
+	s32 *mem_connect;/* where to put the delayed sample (MEM) */
